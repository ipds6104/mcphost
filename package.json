{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.vue --ignore-path .gitignore --fix",
        "docker:dev": "docker compose up --build",
        "docker:down": "docker compose down",
        "docker:restart": "docker compose restart web",
        "docker:clear": "docker compose exec web php artisan optimize:clear && docker compose restart web",
        "docker:optimize": "docker compose exec web php artisan optimize && docker compose restart web",
        "docker:recache": "docker compose exec web php artisan optimize:clear && docker compose exec web php artisan optimize && docker compose restart web",
        "docker:migrate": "docker compose exec web php artisan migrate --force",
        "docker:fresh": "docker compose exec web php artisan migrate:fresh --seed --force && docker compose restart web",
        "docker:bench": "bash scripts/dev-tools.sh bench",
        "docker:logs": "docker compose logs -f --tail=50"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@rushstack/eslint-patch": "^1.8.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^13.0.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^9.0.1",
        "dompurify": "^3.4.5",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.23.0",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.1",
        "marked": "^15.0.0",
        "dompurify": "^3.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.3.0",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-tailwindcss": "^0.6.5",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vue": "^3.4.0",
        "vue-tsc": "^3.3.1"
    },
    "dependencies": {
        "@rolldown/binding-linux-x64-gnu": "^1.0.2"
    }
}
