{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "declare_strict_types": true,
        "modernize_types_casting": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "fully_qualified_strict_types": true,
        "new_with_parentheses": {
            "anonymous_class": false,
            "named_class": true
        }
    }
}
